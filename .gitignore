# ==============================================================================
# .gitignore - Dự Án IoT: Hệ Thống Báo Khói Cảnh Báo Sớm (ESP32 - MQTT - Web)
# ==============================================================================
# Phân loại quy tắc:
# - ĐƯỢC PUSH LÊN GITHUB: Mã nguồn C++ chính (src/), giao diện Web (web/), 
#   cấu hình luồng Node-RED (nodered/*.json), cấu hình Wokwi (diagram.json, wokwi.toml),
#   cấu hình PlatformIO (platformio.ini), file kịch bản MQTTX mẫu, README.md, .gitignore.
# - KHÔNG ĐƯỢC PUSH (Bị chặn nghiêm ngặt): Nhị phân build PlatformIO, thư viện tải tự động,
#   bộ công cụ & script tự động hóa nội bộ (tools/
!scripts/
!scripts/check_claims.py), file báo cáo đồ án (docs/),
#   file khóa tạm Office, nhật ký runtime, thông tin bảo mật & file rác IDE/OS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORMIO, COMPILER & NHỊ PHÂN BIÊN DỊCH PHẦN CỨNG
# Chặn mã máy, file thực thi (.bin, .elf) và thư viện tải tự động (~40MB+)
# ------------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clangd/
.cache/
.gcc-flags.json
compile_commands.json
*.elf
*.bin
*.hex
*.map
*.o
*.a
*.d
*.sconsign*
*.dmp
*.core

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & THÔNG TIN NHẠY CẢM (CRITICAL SECRETS & CREDENTIALS)
# Chống lộ mật khẩu Wi-Fi, MQTT Broker private key, token hoặc API key
# ------------------------------------------------------------------------------
.env
.env.*
*.env
secrets.h
credentials.h
wifi_credentials.h
private_config.h
config_private.h
private.h
*.pem
*.key
*.crt
*.pfx
*.p12
*.token
tokens.json
auth.json
service_account*.json

# ------------------------------------------------------------------------------
# 3. BỘ CÔNG CỤ TỰ ĐỘNG HÓA & SCRIPTS NỘI BỘ (LOCAL TOOLS & AUTOMATION)
# Thư mục tools/
!scripts/
!scripts/check_claims.py và các script sinh tài liệu/slide chỉ chạy local
# ------------------------------------------------------------------------------
tools/
!scripts/
!scripts/check_claims.py
*.py
tests/*.py
nodered/*.py
*.ps1
*.psm1
*.bat
*.cmd

# Scratch, file thử nghiệm tạm thời
test_docx.py
test_*.py
temp_*.py
*_temp.py
scratch/
temp/
tmp/

# ------------------------------------------------------------------------------
# 4. PYTHON BYTECACHE & MÔI TRƯỜNG ẢO (VIRTUAL ENVIRONMENTS)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/*
!lib/core/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. TÀI LIỆU NỘI BỘ, SLIDES & BÁO CÁO ĐỒ ÁN (LOCAL DOCS & LARGE MEDIA)
# Thư mục docs/ chứa báo cáo tiến độ tuần, slide PPTX, Word, PDF kích thước lớn
# ------------------------------------------------------------------------------
docs/
*.docx
*.pptx
*.pdf
*.xlsx
*.xls
*.doc
*.ppt

# ------------------------------------------------------------------------------
# 6. FILE KHÓA TẠM THỜI CỦA MICROSOFT OFFICE (OFFICE LOCK & TEMP FILES)
# Tự sinh khi đang mở Word/PowerPoint/Excel để biên tập báo cáo
# ------------------------------------------------------------------------------
~$*
~$*.docx
~$*.pptx
~$*.xlsx
~$*.doc
~$*.ppt
~$*.xls
~*
*.tmp
*.bak
*.saved
*.auto

# ------------------------------------------------------------------------------
# 7. NHẬT KÝ KIỂM THỬ & RUNTIME TRACES (LOG FILES)
# Tránh đẩy file log chạy thực tế làm bẩn lịch sử commit
# ------------------------------------------------------------------------------
logs/*.log
*.log
*.log.*
*.trace
!logs/.gitkeep

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH IDE & EDITOR CÁ NHÂN (IDE & EDITORS CACHE)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio (Windows)
.vs/
*.suo
*.user
*.userosv
*.sln.docstates

# JetBrains (CLion, PyCharm, WebStorm)
.idea/
*.iml

# Sublime Text & Vim / Emacs
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.orig

# ------------------------------------------------------------------------------
# 9. FILE RÁC HỆ ĐIỀU HÀNH (OS SYSTEM ARTIFACTS)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------------------------
# 10. NODE.JS & WEB DEPENDENCIES (DỰ PHÒNG NẾU CÓ DÙNG NPM)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.parcel-cache/

.nodered_runtime/

